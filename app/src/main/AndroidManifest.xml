<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 局域网直连飞牛 NAS 上的 Jinn 服务端 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 监听网络恢复（WiFi↔热点切换时主动重连）；缺失会导致 registerNetwork 抛 SecurityException 被吞 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 采集麦克风音频送服务端识别 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 诊断日志：经 KernelSU root 预授权 MANAGE_EXTERNAL_STORAGE 后，可直接写入
         /storage/emulated/0/JinnIME/logs/（scoped storage 下唯一直写共享存储的方式）。
         未授权时自动退回应用专属目录，不影响功能。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- 语音输入法服务：持有 BIND_INPUT_METHOD 权限的只有系统，可安全导出 -->
        <service
            android:name=".JinnIme"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 剪贴板历史页：FLAG_SECURE 隐私保护（禁止截图/最近任务预览），
             excludeFromRecents 避免隐私页出现在最近任务列表 -->
        <activity
            android:name=".ClipboardHistoryActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/clipboard_history_title" />

        <!-- 分类词库页：从设置页进入，按需下载/删除可选词库包 -->
        <activity
            android:name=".DictManagerActivity"
            android:exported="false"
            android:label="@string/dict_manager_title" />

        <!-- 设置页：既是输入法设置入口，也可从桌面启动 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
