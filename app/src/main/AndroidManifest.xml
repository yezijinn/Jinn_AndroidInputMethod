<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 局域网直连飞牛 NAS 上的 Jinn 服务端 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 监听网络恢复（WiFi↔热点切换时主动重连）；缺失会导致 registerNetwork 抛 SecurityException 被吞 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 采集麦克风音频送服务端识别 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 前台保活：常驻通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机 / 更新后拉起保活 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 跳转电池白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 诊断日志：经 KernelSU root 预授权 MANAGE_EXTERNAL_STORAGE 后，可直接写入
         /storage/emulated/0/JinnIME/logs/（scoped storage 下唯一直写共享存储的方式）。
         未授权时自动退回应用专属目录，不影响功能。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- 语音输入法服务：持有 BIND_INPUT_METHOD 权限的只有系统，可安全导出 -->
        <service
            android:name=".JinnIme"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 前台保活服务：常驻通知，防掉后台 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保活防杀后台" />
        </service>

        <!-- 无障碍保活：被系统托管，互保前台服务 -->
        <service
            android:name=".JinnAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>

        <!-- 开机 / 更新后拉起保活：接收系统广播必须 exported=true（Android 12+ 强制） -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 剪贴板历史页：FLAG_SECURE 隐私保护（禁止截图/最近任务预览） -->
        <activity
            android:name=".ClipboardHistoryActivity"
            android:exported="false"
            android:label="@string/clipboard_history_title" />

        <!-- 第三方 APP 剪贴板历史访问权限管理（同样 FLAG_SECURE） -->
        <activity
            android:name=".ClipboardPermissionActivity"
            android:exported="false"
            android:label="@string/clipboard_perm_manage" />

        <!-- 方向控制面板：功能面板「方向」按钮打开 -->
        <activity
            android:name=".DirectionPadActivity"
            android:exported="false"
            android:label="@string/direction_pad_title" />

        <!-- 第三方 APP 访问剪贴板历史的安全 IPC 入口（UID 校验，默认拒绝） -->
        <provider
            android:name=".ClipboardHistoryProvider"
            android:authorities="com.jinn.voiceinput.clipboard"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- 设置页：既是输入法设置入口，也可从桌面启动 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
