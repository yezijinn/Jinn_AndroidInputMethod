<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 暗黑主题色板（夜间目录 = 跟随系统深色时的取值）。与 values/colors.xml **逐名对齐**。
         2026-09-21 两处按实测微调（原值对比度不足）：
           danger         #E5484D → #FF5A5F（卡片底上 4.31 → 5.53:1）
           text_on_accent #FFFFFF → #0B1020（白字在亮渐变上仅 1.77~4.23:1；深墨字 4.47~10.68:1，
                          按钮为 bold 15sp 属「大字」，门槛 3:1，全部达标） -->

    <!-- 键盘 -->
    <color name="kb_bg">#15171C</color>
    <color name="kb_divider">#24272E</color>
    <color name="key_bg">#242831</color>
    <color name="key_ripple">#4DFFFFFF</color>
    <color name="surface_hi">#1C1F26</color>

    <!-- 拼音键盘 -->
    <color name="kb_candidate_bg">#1A1D24</color>
    <color name="kb_key">#242831</color>
    <color name="kb_key_pressed">#3A4150</color>
    <color name="kb_key_text">#ECEEF2</color>
    <color name="kb_key_hint_red">#FF5A5F</color>
    <color name="kb_candidate_sel_text">#4C8DFF</color>

    <!-- 文字 -->
    <color name="text_primary">#ECEEF2</color>
    <color name="text_secondary">#9CA3AF</color>

    <!-- 麦克风按钮 -->
    <color name="mic_idle">#2B313C</color>
    <color name="mic_idle_center">#3A4150</color>
    <color name="mic_active">#E5484D</color>
    <color name="mic_active_center">#FF6B6F</color>
    <color name="mic_ring">#E5484D</color>
    <color name="mic_glyph">#FFFFFF</color>

    <!-- 连接状态指示点 -->
    <color name="dot_online">#34D399</color>
    <color name="dot_connecting">#F5A623</color>
    <color name="dot_offline">#FF5A5F</color>

    <!-- 强调与状态 -->
    <color name="accent">#4C8DFF</color>
    <!-- 主按钮文字：暗色主题的按钮是**亮**渐变 → 深墨字（见文件头说明） -->
    <color name="text_on_accent">#0B1020</color>
    <color name="danger">#FF5A5F</color>
    <color name="ok">#4CC38A</color>
    <color name="warn">#F0A020</color>
    <color name="btn_disabled">#3A4150</color>

    <!-- 设置页：极光风格 -->
    <color name="app_bg">#0B1020</color>
    <color name="aurora_bg_top">#1A2340</color>
    <color name="aurora_bg_mid">#101830</color>
    <color name="aurora_bg_bottom">#0B1020</color>
    <color name="card_bg">#141C33</color>
    <color name="card_stroke">#26314F</color>
    <color name="aurora_cyan">#38D5E8</color>
    <color name="aurora_blue">#4C8DFF</color>
    <color name="aurora_purple">#8B5CF6</color>
    <color name="launcher_bg">#15171C</color>

    <!-- 键盘外观页：压在固定「七彩极光」背景上的文字色。
         本页背景是固定色（key_appearance_bg.xml，不随主题变化），所以这里**刻意与亮色目录写同样的值**：
         值相同 ⇒ 观感固定；两套色板同名 ⇒ ThemeColorParityTest 的逐名对齐守卫依然成立。 -->
    <color name="key_appearance_fg">#F3F6FF</color>

       <!-- 按钮涟漪与次级底（原 drawable 硬编码值，逐条搬入） -->
    <color name="ripple_on_accent">#33000000</color>
    <color name="ripple_on_surface">#26FFFFFF</color>
    <color name="btn_secondary_bg">#1E2A4A</color>
    <color name="field_bg">#101830</color>
    <color name="grip">#3A3F48</color>
</resources>
