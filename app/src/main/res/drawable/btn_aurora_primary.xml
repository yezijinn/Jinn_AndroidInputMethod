<?xml version="1.0" encoding="utf-8"?>
<!-- 极光主按钮：青→蓝→紫横向渐变，大圆角 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_accent">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/aurora_cyan"
                android:centerColor="@color/aurora_blue"
                android:endColor="@color/aurora_purple" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
