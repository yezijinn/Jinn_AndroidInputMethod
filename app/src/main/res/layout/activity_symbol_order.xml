<?xml version="1.0" encoding="utf-8"?>
<!-- 符号分组排序页：从设置页「符号分组顺序」按钮进入；每行 ↑↓ 调整次序，改动即时落盘 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PageRoot"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/PageTitle"
            android:text="@string/symbol_order_title"
            android:layout_height="wrap_content"/>

        <Button
            style="@style/PageCloseButton"
            android:id="@+id/btn_symbol_order_close" />
    </LinearLayout>

    <TextView
        style="@style/PageDesc"
        android:id="@+id/text_symbol_order_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/symbol_order_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        style="@style/SettingsButton"
        android:id="@+id/btn_symbol_order_reset"
        android:layout_width="match_parent"
        android:layout_marginTop="4dp"/>
</LinearLayout>
