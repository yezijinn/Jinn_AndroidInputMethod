<?xml version="1.0" encoding="utf-8"?>
<!--
  拼音键盘：候选栏 + 26 键字母区 + 底部功能行。
  布局对齐主流输入法：
   - 第一行 10 个字母（qwertyuiop）
   - 第二行 9 个字母（asdfghjkl）
   - 第三行 = 切换大写 + 7 个字母（zxcvbnm）+ 删除键
   - 第四行 = 符号、数字、逗号、空格（长按语音）、句号、中英切换、回车确定
  手势与输入逻辑全部放在 PinyinKeyboardView，本布局只做静态骨架。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <!-- 候选栏：拼音 + 候选词 -->
    <LinearLayout
        android:id="@+id/candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/kb_candidate_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/candidate_pinyin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:maxWidth="120dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candidate_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 26 键字母区 / 剪贴板面板共用容器：
         - 字母模式：高度 wrap_content（字母区自身 3 行高度），键盘紧凑
         - 剪贴板模式：代码中动态设置确定高度，撑满候选栏与底部栏之间空间 -->
    <FrameLayout
        android:id="@+id/keyboard_content_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 26 键字母区 -->
        <LinearLayout
            android:id="@+id/keyboard_letters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp">

        <!-- 第一行：10 个字母 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_q"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_w"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_e"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_r"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_t"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_y"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_u"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_i"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_o"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_p"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 第二行：9 个字母 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_a"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_s"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_d"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_f"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_g"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_h"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_j"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_k"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_l"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 第三行：切换大写 + 7 个字母 + 删除键 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/key_shift"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:background="@drawable/key_bg"
                android:contentDescription="@string/cd_shift"
                android:minWidth="0dp"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shift" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_z"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_x"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_c"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_v"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_b"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_n"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.voiceinput.PinyinKey
                android:id="@+id/key_m"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/key_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:background="@drawable/key_bg"
                android:contentDescription="@string/cd_backspace"
                android:minWidth="0dp"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_backspace" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>

    <!-- 第四行：符号 / 数字 / 逗号 / 空格(长按语音) / 句号 / 中英切换 / 回车确定 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/key_symbol"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:minWidth="0dp"
            android:text="@string/key_symbol" />

        <Button
            android:id="@+id/key_digit"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.3"
            android:minWidth="0dp"
            android:text="@string/key_digit" />

        <Button
            android:id="@+id/key_comma"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.1"
            android:minWidth="0dp"
            android:text="@string/key_comma" />

        <LinearLayout
            android:id="@+id/key_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="2.4"
            android:background="@drawable/key_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/key_space_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"
                android:text="@string/space_hint_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_space"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/key_period"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.1"
            android:minWidth="0dp"
            android:text="@string/key_period" />

        <Button
            android:id="@+id/key_lang"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.3"
            android:minWidth="0dp"
            android:text="@string/key_cn" />

        <ImageButton
            android:id="@+id/key_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.4"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_enter"
            android:minWidth="0dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_enter" />
    </LinearLayout>
</LinearLayout>
