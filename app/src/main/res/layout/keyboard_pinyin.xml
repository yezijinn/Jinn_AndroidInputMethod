<?xml version="1.0" encoding="utf-8"?>
<!--
  拼音键盘：候选栏 + 26 键字母区 + 底部功能行。
  布局对齐主流输入法：
   - 第一行 10 个字母（qwertyuiop）
   - 第二行 9 个字母（asdfghjkl）
   - 第三行 = 切换大写 + 7 个字母（zxcvbnm）+ 删除键
   - 第四行 = 符号、数字、逗号、空格（长按语音）、句号、中英切换、回车确定
  手势与输入逻辑全部放在 PinyinKeyboardView，本布局只做静态骨架。
-->
<!--
  两根轴（别再把候选栏塞回键区的竖向流里）：
   - 键区 = keyboard_body：顶部让出「收起档候选栏」的高度（marginTop 由 applyCandidateRows
     按当前字号逐帧落位，XML 的 46dp 只是默认档占位）。**它永不移动**。
   - 候选栏 = candidate_bar：叠在键区之上、贴顶，高度随档位 / 展开态长高。
  根的 wrap_content 取「两者较高者」—— 键区恒为「收起栏高 + 键区」，候选栏最长也只到键区腰部，
  故 IME 窗口总高恒定 ⇒ 展开 / 收起不再有整段跳变（2026-10-21）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg">

    <!-- 键区（字母区 / 剪贴板面板容器 + 底部功能行）：永不移动，见上 -->
    <LinearLayout
        android:id="@+id/keyboard_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        android:orientation="vertical">

        <!-- 26 键字母区 / 剪贴板面板共用容器：
             - 字母模式：高度 wrap_content（字母区自身 3 行高度），键盘紧凑
             - 剪贴板模式：代码中动态设置确定高度，撑满候选栏与底部栏之间空间 -->
        <FrameLayout
            android:id="@+id/keyboard_content_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 26 键字母区 -->
            <LinearLayout
                android:id="@+id/keyboard_letters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

            <!-- 第一行：10 个字母 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal">

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_q"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_w"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_e"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_r"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_t"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_y"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_u"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_i"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_o"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_p"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 第二行：9 个字母 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal">

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_a"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_s"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_d"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_f"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_g"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_h"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_j"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_k"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_l"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 第三行：切换大写 + 7 个字母 + 删除键 -->
            <!-- 两把功能键的图标走 fitCenter，绘制尺寸被「键框减 padding」框死：13dp 内缩在
                 360dp 宽屏上只剩约 10dp（键宽 36dp ⇒ 36-26），图标显得很小。改 8dp 后可用区
                 20dp×54dp ⇒ 图标 20dp，正好是原先的两倍（要求「内部文本两倍」）。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/key_shift"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.875"
                    android:background="@drawable/key_bg"
                    android:contentDescription="@string/cd_shift"
                    android:minWidth="0dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shift" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_z"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_x"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_c"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_v"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_b"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_n"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_m"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <!-- 分号键：仅「ing 落在分号上」的方案（搜狗/微软/紫光）需要，
                     其余方案与符号层/数字层一律 GONE（不占宽度，26 键布局零影响） -->
                <com.jinn.inputmethod.PinyinKey
                    android:id="@+id/key_semicolon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/key_backspace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.875"
                    android:background="@drawable/key_bg"
                    android:contentDescription="@string/cd_backspace"
                    android:minWidth="0dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_backspace" />
            </LinearLayout>
        </LinearLayout>
        </FrameLayout>

        <!-- 第四行：符号 / 数字 / 逗号 / 空格(长按语音) / 句号 / 中英切换 / 回车确定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/key_symbol"
                style="@style/SettingsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:minWidth="0dp"
                android:text="@string/key_symbol" />

            <Button
                android:id="@+id/key_digit"
                style="@style/SettingsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1.3"
                android:minWidth="0dp"
                android:text="@string/key_digit" />

            <Button
                android:id="@+id/key_comma"
                style="@style/SettingsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1.1"
                android:minWidth="0dp"
                android:text="@string/key_comma" />

            <LinearLayout
                android:id="@+id/key_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="2.4"
                android:background="@drawable/key_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/key_space_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:text="@string/space_hint_placeholder"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/key_space"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/key_period"
                style="@style/SettingsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1.1"
                android:minWidth="0dp"
                android:text="@string/key_period" />

            <Button
                android:id="@+id/key_lang"
                style="@style/SettingsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1.3"
                android:minWidth="0dp"
                android:text="@string/key_cn" />

            <ImageButton
                android:id="@+id/key_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1.4"
                android:background="@drawable/key_bg"
                android:contentDescription="@string/cd_enter"
                android:minWidth="0dp"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_enter" />
        </LinearLayout>
    </LinearLayout>

    <!-- 候选栏：拼音条（横条）+ 候选（横向滚动）+ 清空按钮（叠在整栏右侧）。
         几何见 CandidateRows：单行档 = 拼音条贴顶 + 一排候选（默认档共 46dp）；
         双行档 = 上排 / 拼音条（垂直居中，正好落在两排之间的中缝）/ 下排（默认档共 74dp）。
         下面的 46dp / 18dp / 14sp 只是**默认档的占位值**：字号是用户参数（CandidateText），
         运行时一律由 applyCandidateRows 按「当前字号 + 系统字体缩放」重落 —— 每个值都要与
         CandidateRows 的默认档派生值一致（守卫 CandidateRowsTest.布局尺寸与代码常量逐项一致）。
         拼音与候选之间**不留间隔**：拼音条只按字形高度给（拼音字号 × 1.3），字体行框的多余余量
         溢出条外、由 clipChildren=false 放行（裁的只是空白，不是笔画）。
         拼音条是叠放层：无拼音时 GONE，候选区（含功能面板）占满整栏 —— 避让由
         PinyinKeyboardView.showPinyin 落位，高度与位置由 applyCandidateRows 落位。 -->

    <!-- 叠放层：贴顶、向下长。它盖住多少键区，窗口高度都不变（根取「两者较高者」）——
         展开时栏底正好落在字母行缝上（整行覆盖，不拦腰截断某行键），见 CandidateRows.expandedBarHeightPx。 -->
    <FrameLayout
        android:id="@+id/candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_gravity="top"
        android:background="@color/kb_candidate_bg">

        <!-- 候选滚动区。**必须排在拼音条之前**：FrameLayout 里后加的子项绘制与触摸都在上层，
             候选区虽然透明却铺满整栏 —— 排在后面会把拼音条里的 ✕ 挡到点不动（2026-09-25 真机复现）。
             无障碍遍历顺序由 accessibilityTraversalAfter 拉正（语义上先读拼音串再读候选）。 -->
        <!-- 候选区的**纵向**滚动层（展开态专用）：横向由内层 CandidateScrollView 负责，
             纵向（看第 5 行起）由本层跟手滚动。平时纵向不滚动、高度跟随栏高（wrap 行为不变）。
             ⚠ 必须排在内层之前：FrameLayout 里后加的子项在上层，纵向层若在后会把候选挡住点不到。 -->
        <com.jinn.inputmethod.CandidateRowsScrollView
            android:id="@+id/candidate_rows_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <com.jinn.inputmethod.CandidateScrollView
                android:id="@+id/candidate_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:accessibilityTraversalAfter="@id/pinyin_bar"
                android:fillViewport="true"
                android:scrollbars="none">

                <!-- 候选区纵向两层：功能按钮行 + 固定数字行。
                     按钮行 match_parent 吃剩余高度，数字行按自身行框（wrap_content）——
                     两行**都不得**用 weight 平分：它们同处横向滚动容器的内容里，而它给子项的
                     高度是 UNSPECIFIED，两个 weight=1 分到的是「两行内容高之和」而非栏高
                     （单行档下双双溢出、数字行被栏底裁成半截，2026-10-19 实测）。
                     ⚠ candidate_list 也**不能**写 0dp+weight=1：candidate_scroll 有
                     paddingTop（单行档为拼音条让位），fillViewport 会把 stack 拉到**未扣
                     padding** 的高度 ⇒ 候选区溢出栏外，且 center_vertical 把候选 TextView
                     量成 0 高（真机 GEO：padTop=63 / scrollH=161 / listH=161 / firstH=0
                     ⇒ 输入 ji 后候选整体下沉看不见，2026-10-20 实测）。
                     match_parent 下 stack 高 = 视口 - paddingTop，候选区正好落在拼音条下方；
                     数字行 GONE 时不占位，按钮行独占整栏（与没有这一行时几何一致）。
                     包一层而不是给 ScrollView 加兄弟：滚动容器只允许一个子 View。 -->
                <LinearLayout
                    android:id="@+id/candidate_panel_stack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/candidate_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                    <!-- 功能面板下方的固定数字行 1..0：子项由代码建一次
                         （PinyinKeyboardView.buildFunctionDigitRow），只在此面板形态显示。
                         高度按内容 ⇒ 栏高不足时整行不显示，不会被裁成半截 -->
                    <LinearLayout
                        android:id="@+id/function_digit_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone" />
                </LinearLayout>
            </com.jinn.inputmethod.CandidateScrollView>
        </com.jinn.inputmethod.CandidateRowsScrollView>

        <!-- 拼音条（叠放层，最后添加 ⇒ 在候选之上）：位置由 gravity 决定（单行档贴顶 / 双行档垂直居中），
             高度与位置由 applyCandidateRows 落位、显隐由 showPinyin 落位。 -->
        <FrameLayout
            android:id="@+id/pinyin_bar"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_gravity="top"
            android:clipChildren="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- 拼音串：整条全宽（不再限宽），右端留出清空按钮的位置；
                 左内边距由父级拼音条提供，这里显式写 0 以满足 RTL 对称性检查 -->
            <TextView
                android:id="@+id/candidate_pinyin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="40dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- 展开候选栏（▲/▾）：位于 ✕ **左侧**，与它同高、紧挨但不重叠（✕ 占 end 40dp，
                 本键再退 40dp）。仅在「候选行数 = 1 行」档、且候选多到需要展开时出现（BUG.md L-1393）。
                 展开 = 候选栏**向下覆盖键区**（窗口总高不变、键区不动），一屏最多四排候选；
                 再点 = 收起（点 ✕ 或选中候选同样收起）。
                 图标用字符，不新增可见文案（文案属作者域、strings.xml 不动）。 -->
            <TextView
                android:id="@+id/btn_expand_candidates"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginEnd="40dp"
                android:gravity="center"
                android:text="▲"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 清空候选（✕）：与拼音条同高、贴其右端 —— 单行档在顶部那一行、双行档在中间那行，
                 **都不与候选文字重叠**（用户 2026-09-25 要求），因此候选区不再为它让出右边距。
                 点击 = 完全清空候选词与拼音串，候选栏回到默认的 6 按钮功能面板；
                 2026-09-20 起取代「长按退格整串清空拼音」的隐式手势。 -->
            <TextView
                android:id="@+id/btn_clear_candidates"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:contentDescription="@string/cd_clear_candidates"
                android:gravity="center"
                android:text="@string/key_clear_candidates"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

    </FrameLayout>
</FrameLayout>
