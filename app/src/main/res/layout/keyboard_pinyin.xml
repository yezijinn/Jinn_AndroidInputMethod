<?xml version="1.0" encoding="utf-8"?>
<!--
  拼音键盘：候选栏 + 26 键字母区 + 底部功能行。
  布局对齐主流输入法：
   - 第一行 10 个字母（qwertyuiop）
   - 第二行 9 个字母（asdfghjkl）
   - 第三行 = 切换大写 + 7 个字母（zxcvbnm）+ 删除键
   - 第四行 = 符号、数字、逗号、空格（长按语音）、句号、中英切换、回车确定
  手势与输入逻辑全部放在 PinyinKeyboardView，本布局只做静态骨架。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg"
    android:orientation="vertical">

    <!-- 候选栏：拼音条（横条）+ 候选（横向滚动）+ 清空按钮（叠在整栏右侧）。
         几何见 CandidateRows：单行档 = 拼音条 16dp 贴顶 + 一排候选 28dp（共 44dp）；
         双行档 = 上排 / 拼音条（垂直居中，正好落在两排之间的中缝）/ 下排（共 72dp）。
         拼音与候选之间**不留间隔**：拼音条只按字形高度给（14sp × 1.15），字体行框的多余余量
         溢出条外、由 clipChildren=false 放行（裁的只是空白，不是笔画）。
         拼音条是叠放层：无拼音时 GONE，候选区（含功能面板）占满整栏 —— 避让由
         PinyinKeyboardView.showPinyin 落位，高度与位置由 applyCandidateRows 落位。 -->
    <FrameLayout
        android:id="@+id/candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/kb_candidate_bg">

        <!-- 叠放层：位置由 gravity 决定（单行档贴顶 / 双行档垂直居中），不靠子项顺序；
             视图树里排在候选之前 —— 无障碍遍历按视图树先序，先读拼音串再读候选更顺。 -->
        <FrameLayout
            android:id="@+id/pinyin_bar"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_gravity="top"
            android:clipChildren="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- 拼音串：整条全宽（不再限宽），右端留出清空按钮的位置；
                 左内边距由父级拼音条提供，这里显式写 0 以满足 RTL 对称性检查 -->
            <TextView
                android:id="@+id/candidate_pinyin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="40dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- 清空候选（✕）：与拼音条同高、贴其右端 —— 单行档在顶部那一行、双行档在中间那行，
                 **都不与候选文字重叠**（用户 2026-09-25 要求），因此候选区不再为它让出右边距。
                 点击 = 完全清空候选词与拼音串，候选栏回到默认的 6 按钮功能面板；
                 2026-09-20 起取代「长按退格整串清空拼音」的隐式手势。 -->
            <TextView
                android:id="@+id/btn_clear_candidates"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:contentDescription="@string/cd_clear_candidates"
                android:gravity="center"
                android:text="@string/key_clear_candidates"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/candidate_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candidate_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </FrameLayout>

    <!-- 26 键字母区 / 剪贴板面板共用容器：
         - 字母模式：高度 wrap_content（字母区自身 3 行高度），键盘紧凑
         - 剪贴板模式：代码中动态设置确定高度，撑满候选栏与底部栏之间空间 -->
    <FrameLayout
        android:id="@+id/keyboard_content_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 26 键字母区 -->
        <LinearLayout
            android:id="@+id/keyboard_letters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

        <!-- 第一行：10 个字母 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_q"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_w"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_e"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_r"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_t"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_y"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_u"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_i"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_o"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_p"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 第二行：9 个字母 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_a"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_s"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_d"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_f"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_g"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_h"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_j"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_k"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_l"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 第三行：切换大写 + 7 个字母 + 删除键 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/key_shift"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:background="@drawable/key_bg"
                android:contentDescription="@string/cd_shift"
                android:minWidth="0dp"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shift" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_z"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_x"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_c"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_v"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_b"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_n"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_m"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- 分号键：仅「ing 落在分号上」的方案（搜狗/微软/紫光）需要，
                 其余方案与符号层/数字层一律 GONE（不占宽度，26 键布局零影响） -->
            <com.jinn.inputmethod.PinyinKey
                android:id="@+id/key_semicolon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/key_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:background="@drawable/key_bg"
                android:contentDescription="@string/cd_backspace"
                android:minWidth="0dp"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_backspace" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>

    <!-- 第四行：符号 / 数字 / 逗号 / 空格(长按语音) / 句号 / 中英切换 / 回车确定 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/key_symbol"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:minWidth="0dp"
            android:text="@string/key_symbol" />

        <Button
            android:id="@+id/key_digit"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.3"
            android:minWidth="0dp"
            android:text="@string/key_digit" />

        <Button
            android:id="@+id/key_comma"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.1"
            android:minWidth="0dp"
            android:text="@string/key_comma" />

        <LinearLayout
            android:id="@+id/key_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="2.4"
            android:background="@drawable/key_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/key_space_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"
                android:text="@string/space_hint_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/key_space"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/key_period"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.1"
            android:minWidth="0dp"
            android:text="@string/key_period" />

        <Button
            android:id="@+id/key_lang"
            style="@style/SettingsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.3"
            android:minWidth="0dp"
            android:text="@string/key_cn" />

        <ImageButton
            android:id="@+id/key_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1.4"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_enter"
            android:minWidth="0dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_enter" />
    </LinearLayout>
</LinearLayout>
