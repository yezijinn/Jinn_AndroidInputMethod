<?xml version="1.0" encoding="utf-8"?>
<!-- 键盘外观页：26 键区统一圆角 + 按键间隙；拖动即落盘，松手即时生效。
     外层 ScrollView：横屏 / 小屏 + 键盘弹出时下半屏会被键盘遮住，必须能滚动（与设置页等表单页同款）。
     背景是本页专属的**固定七彩极光**（@drawable/key_appearance_bg，不随亮白/暗黑切换）——
     它画在**窗口底色**上（见 KeyAppearanceActivity），不在根布局上：键盘弹起时内容被顶到键盘上方，
     键盘覆盖区背后只剩窗口底色，画在窗口上才能连成一片、并让键盘的半透明有对比可见。
     直接压在极光上的标题与说明用固定浅色（@color/key_appearance_fg*）——卡片内文字仍走主题色。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/key_appearance_title"
                android:textColor="@color/key_appearance_fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_key_appearance_close"
                style="@style/SettingsButton"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/symbol_order_close"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="@string/key_appearance_desc"
            android:textColor="@color/key_appearance_fg_dim"
            android:textSize="12sp" />

        <!-- 测试编辑框：点这里唤起键盘，方便对照着调圆角 / 间隙 -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/field_aurora"
            android:hint="@string/settings_ime_test_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_aurora"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 按键圆角 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/key_corner_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seek_key_corner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressBackgroundTint="@color/card_stroke"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/text_key_corner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="56dp"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 按键间隙：左右间隙与上下间隙由同一个值控制 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/key_gap_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seek_key_gap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressBackgroundTint="@color/card_stroke"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/text_key_gap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="56dp"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 键盘透明度：只淡「面」不淡文字；双拼提示等文字保持原色 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/key_transparency_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seek_key_transparency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressBackgroundTint="@color/card_stroke"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/text_key_transparency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="56dp"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/key_transparency_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/key_appearance_apply_hint"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
