<?xml version="1.0" encoding="utf-8"?>
<!-- 用户词库页（2026-10-18）：选择台账的查看 / 合并 / 导出 / 导入。
     骨架与其它子页一致（PageRoot / PageTitle / PageCloseButton / PageDesc）；
     文案全部由代码下发（strings.xml 默认禁改）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PageRoot"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/PageTitle"
            android:id="@+id/text_dict_title"
            android:layout_height="wrap_content" />

        <Button
            style="@style/PageCloseButton"
            android:id="@+id/btn_dict_close" />
    </LinearLayout>

    <TextView
        style="@style/PageDesc"
        android:id="@+id/text_dict_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            style="@style/SettingsButton"
            android:id="@+id/btn_export_yaml"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:minWidth="0dp" />

        <Button
            style="@style/SettingsButton"
            android:id="@+id/btn_export_tsv"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minWidth="0dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            style="@style/SettingsButton"
            android:id="@+id/btn_export_txt"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:minWidth="0dp" />

        <Button
            style="@style/SettingsButton"
            android:id="@+id/btn_import_dict"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minWidth="0dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/list_dict_entries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:overScrollMode="never" />

    <Button
        style="@style/SettingsButton"
        android:id="@+id/btn_delete_dict"
        android:layout_width="match_parent"
        android:layout_marginTop="6dp"
        android:minWidth="0dp" />
</LinearLayout>
