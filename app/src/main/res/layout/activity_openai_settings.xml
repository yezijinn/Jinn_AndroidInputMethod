<?xml version="1.0" encoding="utf-8"?>
<!-- OpenAI 兼容配置页：基础参数 / 翻译设置 / 模型参数 / 高级，四段纵排。
     文案（含 label、hint、按钮）全部在 OpenAiSettingsActivity 里下发（strings.xml 默认禁改）；
     布局里的 label 只挂 labelFor 做无障碍关联（LabelFor 例外见 app/lint.xml） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_ai_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_ai_close"
            style="@style/SettingsButton"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_ai_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── 基础 ─────────────────────────────── -->
            <TextView
                android:id="@+id/label_ai_section_basic"
                style="@style/SettingsLabel"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/label_ai_name"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_name" />

            <EditText
                android:id="@+id/edit_ai_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_base_url"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_base_url" />

            <EditText
                android:id="@+id/edit_ai_base_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_api_key"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_api_key" />

            <EditText
                android:id="@+id/edit_ai_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:saveEnabled="false"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_model"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_model" />

            <EditText
                android:id="@+id/edit_ai_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_ai_fetch_models"
                    style="@style/SettingsButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_ai_test"
                    style="@style/SettingsButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_ai_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="false"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- ── 翻译设置 ─────────────────────────── -->
            <TextView
                android:id="@+id/label_ai_section_prompt"
                style="@style/SettingsLabel"
                android:layout_marginTop="14dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/label_ai_target"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/spinner_ai_target" />

            <Spinner
                android:id="@+id/spinner_ai_target"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/field_aurora"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:id="@+id/label_ai_target_custom"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_target_custom" />

            <EditText
                android:id="@+id/edit_ai_target_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_system"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_system" />

            <EditText
                android:id="@+id/edit_ai_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="8"
                android:minLines="2"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/label_ai_user"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_user" />

            <EditText
                android:id="@+id/edit_ai_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="8"
                android:minLines="2"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_ai_prompt_reset"
                style="@style/SettingsButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp" />

            <!-- ── 模型参数 ─────────────────────────── -->
            <TextView
                android:id="@+id/label_ai_section_params"
                style="@style/SettingsLabel"
                android:layout_marginTop="14dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/label_ai_temperature"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_temperature" />

            <EditText
                android:id="@+id/edit_ai_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_top_p"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_top_p" />

            <EditText
                android:id="@+id/edit_ai_top_p"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_max_tokens"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_max_tokens" />

            <EditText
                android:id="@+id/edit_ai_max_tokens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="number"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <!-- ── 高级 ─────────────────────────────── -->
            <TextView
                android:id="@+id/label_ai_section_advanced"
                style="@style/SettingsLabel"
                android:layout_marginTop="14dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/label_ai_chat_path"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_chat_path" />

            <EditText
                android:id="@+id/edit_ai_chat_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_models_path"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_models_path" />

            <EditText
                android:id="@+id/edit_ai_models_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_response_path"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_response_path" />

            <EditText
                android:id="@+id/edit_ai_response_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_timeout"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_timeout" />

            <EditText
                android:id="@+id/edit_ai_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:importantForAutofill="no"
                android:inputType="number"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/label_ai_headers"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_headers" />

            <EditText
                android:id="@+id/edit_ai_headers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:minLines="2"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/label_ai_extra_json"
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edit_ai_extra_json" />

            <EditText
                android:id="@+id/edit_ai_extra_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_aurora"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="8"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_ai_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:singleLine="false"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 显式保存（2026-10-01 用户要求）：参数仍会即时落盘，这里再给一个**固定的**保存出口 ——
         参数多且分组，用户改完可能不确定是否生效；点完有明确结果提示（即使多此一举） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_ai_save"
            style="@style/SettingsButton"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:id="@+id/text_ai_save_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="false"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
