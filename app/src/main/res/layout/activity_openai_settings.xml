<?xml version="1.0" encoding="utf-8"?>
<!-- OpenAI 兼容配置页：基础参数 / 翻译设置 / 模型参数 / 高级，四段纵排。
     文案（含 label、hint、按钮）全部在 OpenAiSettingsActivity 里下发（strings.xml 默认不改动）；
     布局里的 label 只挂 labelFor 做无障碍关联（LabelFor 例外见 app/lint.xml） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PageRoot"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/PageTitle"
            android:id="@+id/text_ai_title"
            android:layout_height="wrap_content" />

        <Button
            style="@style/PageCloseButton"
            android:id="@+id/btn_ai_close" />
    </LinearLayout>

    <TextView
        style="@style/PageDesc"
        android:id="@+id/text_ai_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── 基础 ─────────────────────────────── -->
            <LinearLayout style="@style/SettingsCard">
                <TextView
                    style="@style/SectionTitle"
                    android:id="@+id/label_ai_section_basic"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_name"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_name" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_name"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_base_url"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_base_url" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_base_url"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:saveEnabled="false"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_api_key"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_api_key" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_api_key"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:saveEnabled="false"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_model"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_model" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_model"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/SettingsButton"
                        android:id="@+id/btn_ai_fetch_models"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <Button
                        style="@style/SettingsButton"
                        android:id="@+id/btn_ai_test"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    style="@style/CardHint"
                    android:id="@+id/text_ai_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    />

                <!-- ── 翻译设置 ─────────────────────────── -->
            </LinearLayout>
            <LinearLayout style="@style/SettingsCard">
                <TextView
                    style="@style/SectionTitle"
                    android:id="@+id/label_ai_section_prompt"
                    android:layout_marginTop="6dp"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_target"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/spinner_ai_target" />

                <com.jinn.inputmethod.UserAwareSpinner
                    style="@style/SettingsField"
                    android:id="@+id/spinner_ai_target"
                    android:layout_width="match_parent"
                    android:layout_marginTop="2dp"
                    android:spinnerMode="dropdown"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_target_custom"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_target_custom" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_target_custom"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_system"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_system" />

                <EditText
                    style="@style/SettingsFieldMultiline"
                    android:id="@+id/edit_ai_system"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="8"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_user"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_user" />

                <EditText
                    style="@style/SettingsFieldMultiline"
                    android:id="@+id/edit_ai_user"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="8"/>

                <Button
                    style="@style/SettingsButton"
                    android:id="@+id/btn_ai_prompt_reset"
                    android:layout_width="match_parent"
                    android:layout_marginTop="3dp" />

                <!-- ── 模型参数 ─────────────────────────── -->
            </LinearLayout>
            <LinearLayout style="@style/SettingsCard">
                <TextView
                    style="@style/SectionTitle"
                    android:id="@+id/label_ai_section_params"
                    android:layout_marginTop="6dp"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_temperature"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_temperature" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_temperature"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_top_p"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_top_p" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_top_p"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_max_tokens"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_max_tokens" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_max_tokens"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:singleLine="true"/>

                <!-- ── 高级 ─────────────────────────────── -->
            </LinearLayout>
            <LinearLayout style="@style/SettingsCard">
                <TextView
                    style="@style/SectionTitle"
                    android:id="@+id/label_ai_section_advanced"
                    android:layout_marginTop="6dp"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_chat_path"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_chat_path" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_chat_path"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_models_path"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_models_path" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_models_path"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_response_path"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_response_path" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_response_path"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_timeout"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_timeout" />

                <EditText
                    style="@style/SettingsField"
                    android:id="@+id/edit_ai_timeout"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:singleLine="true"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_headers"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_headers" />

                <EditText
                    style="@style/SettingsFieldMultiline"
                    android:id="@+id/edit_ai_headers"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="6"/>

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/label_ai_extra_json"
                    android:layout_marginTop="4dp"
                    android:labelFor="@id/edit_ai_extra_json" />

                <EditText
                    style="@style/SettingsFieldMultiline"
                    android:id="@+id/edit_ai_extra_json"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="8"/>

                <TextView
                    style="@style/CardHint"
                    android:id="@+id/text_ai_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 显式保存（2026-10-01）：参数仍会即时落盘，这里再给一个**固定的**保存出口 ——
         参数多且分组，用户改完可能不确定是否生效；点完有明确结果提示（即使多此一举） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <Button
            style="@style/SettingsButton"
            android:id="@+id/btn_ai_save"
            android:layout_width="match_parent" />

        <TextView
            style="@style/CardHint"
            android:id="@+id/text_ai_save_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            />
    </LinearLayout>
</LinearLayout>
