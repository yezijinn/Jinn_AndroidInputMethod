<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 设置页分组标题 -->

    <!-- 设置页字段标签 -->
    <style name="SettingsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- 普通按钮：极光次级样式，圆角、固定高度、按压态 -->
    <style name="SettingsButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/btn_aurora_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 主按钮：极光渐变填充 -->
    <style name="SettingsButtonPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/btn_aurora_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
      对话框主题（AppTheme 的 alertDialogTheme 指向它）。
      框架 AlertDialog 默认取 Material 的**浅色**对话框主题，暗黑界面下会白底黑字、与页面撞色，
      所以这里显式换成 App 的配色令牌；面板圆角与内边距仍由父主题提供，只替换颜色。
      取值随 values-night/colors.xml 自动切换；夜间目录另有一份同名完整定义（同名 style 整条替换）。
    -->
    <style name="AppDialogTheme" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
