<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 亮白主题（默认目录）。暗黑主题在 values-night/themes.xml —— 同名 style 是**整条替换**、
         不做 item 合并，那边必须写完整定义。
         基于系统 Material Light 框架主题，不引入 AppCompat / Material Components，保持包体最小。 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar" tools:targetApi="o_mr1">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <!-- 对话框（框架 AlertDialog）跟页面配色，定义见 styles.xml 的 AppDialogTheme；
             不设它会走 Material 的浅色对话框主题，暗黑界面下白底黑字 -->
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <!-- 浅底状态栏/导航栏 → 图标需转深色（windowLightNavigationBar 为 API 27+，由 tools:targetApi 标注） -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
