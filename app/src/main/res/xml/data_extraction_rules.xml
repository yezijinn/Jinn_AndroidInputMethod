<?xml version="1.0" encoding="utf-8"?>
<!--
  剪贴板历史数据提取规则（Android 12+，方案第二十一节）：
  云端备份（cloud-backup）排除剪贴板数据库；设备间迁移（device-transfer）
  同样排除，防止加密正文与新设备的密钥不匹配造成不可解数据。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="jinn_clipboard.db" />
        <!-- SQLite 在 WAL 模式下会把最近提交写在 -wal 里，-journal/-shm 同理：
             只排除主库文件会漏掉这部分（backup_rules.xml 已排除这三项，这里必须同步）。 -->
        <exclude
            domain="database"
            path="jinn_clipboard.db-journal" />
        <exclude
            domain="database"
            path="jinn_clipboard.db-wal" />
        <exclude
            domain="database"
            path="jinn_clipboard.db-shm" />
        <exclude
            domain="file"
            path="user_freq.txt" />
        <!-- 选择台账：默认关闭，但同样不进云备份/设备迁移（看了说明并手输 OK 才开）；
             2026-10-21 起逐行加密，密钥包裹件 user_picks.key 一并排除（换机后解不开） -->
        <exclude
            domain="file"
            path="user_picks.txt" />
        <exclude
            domain="file"
            path="user_picks.key" />
        <!-- 密钥件残留（原子写的中间件）与孤儿件目录（密钥件丢失时台账 / 词频被改名到这里；
             名字带毫秒后缀，逐名排除排不掉，必须按固定目录排） -->
        <exclude
            domain="file"
            path="user_picks.key.tmp" />
        <exclude
            domain="file"
            path="ledger_orphan/" />
        <!-- 台账整表的两个原子写中间件（崩溃落在「写完整表 → rename」之间时留下） -->
        <exclude
            domain="file"
            path="user_picks.txt.mig" />
        <exclude
            domain="file"
            path="user_picks.txt.reheader" />
        <!-- 剪贴板图片目录（filesDir/clipboard/）：密文 + 密钥不可备份（恢复后一条也解不开），
             且体积会挤爆 25MB 配额 —— 见 backup_rules.xml 同名条目的完整理由。
             ⚠ 云备份与设备迁移两个域都要排（本文件里各有一份清单）。 -->
        <exclude
            domain="file"
            path="clipboard/" />
        <exclude
            domain="file"
            path="user_freq.txt.tmp" />
        <exclude
            domain="sharedpref"
            path="jinn_inputmethod.xml" />
        <!-- 平台写的 `.bak`（= 上一版配置，含旧凭据密文）也必须排（2026-10-02 修复 L-408） -->
        <exclude
            domain="sharedpref"
            path="jinn_inputmethod.xml.bak" />
        <exclude
            domain="sharedpref"
            path="jinn_clipboard.xml" />
        <exclude
            domain="sharedpref"
            path="jinn_clipboard.xml.bak" />

    <!-- 索引缓存是可**再生**的（基础 14 MB 上下、可选包各十几 MB）：交给 Auto Backup 只会挤占
         25MB 配额（超限会让整包备份失败，连真正该备份的下载词库也备份不上），而换机恢复后
         它的键（APK mtime）必然对不上，仍要靠清扫自愈。词库包 `dicts/` 是用户下载的**真数据**，
         故意**不**排除（`BUG.md` L-152）。 -->
    <exclude
        domain="file"
        path="index/" />
    <!-- 词库包的下载 / 恢复中间件（断网或崩溃时残留，单个最大 5.89 MB）：
         越过 25MB 配额会让整包备份失败；排除项不支持通配，只能逐名排。
         `dicts/` 本身仍不排除（用户下载的真数据，L-152）。 -->
    <exclude domain="file" path="dicts/part2.xz.tmp" />
    <exclude domain="file" path="dicts/part3.xz.tmp" />
    <exclude domain="file" path="dicts/part4.xz.tmp" />
    <exclude domain="file" path="dicts/custom_user.txt.xz.tmp" />
    <exclude domain="file" path="dicts/custom_user.src.txt.tmp" />
    <exclude domain="file" path="dicts/part2.xz.restore" />
    <exclude domain="file" path="dicts/part3.xz.restore" />
    <exclude domain="file" path="dicts/part4.xz.restore" />
    <exclude domain="file" path="dicts/custom_user.txt.xz.restore" />
    <exclude domain="file" path="dicts/custom_user.src.txt.restore" />
    <!-- 诊断日志目录在 `external` 域（`getExternalFilesDir()/logs/`）里，默认会被上传：
         日志含崩溃快照（退回全量时含其它应用的行）、端点主机名、凭据长度指纹，
         且 32 MB 预算 > 25 MB 配额会让整包备份失败（2026-10-02 修复） -->
    <exclude
        domain="external"
        path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="jinn_clipboard.db" />
        <exclude
            domain="database"
            path="jinn_clipboard.db-journal" />
        <exclude
            domain="database"
            path="jinn_clipboard.db-wal" />
        <exclude
            domain="database"
            path="jinn_clipboard.db-shm" />
        <exclude
            domain="file"
            path="user_freq.txt" />
        <!-- 选择台账：默认关闭，但同样不进云备份/设备迁移（看了说明并手输 OK 才开）；
             2026-10-21 起逐行加密，密钥包裹件 user_picks.key 一并排除（换机后解不开） -->
        <exclude
            domain="file"
            path="user_picks.txt" />
        <exclude
            domain="file"
            path="user_picks.key" />
        <!-- 密钥件残留（原子写的中间件）与孤儿件目录（密钥件丢失时台账 / 词频被改名到这里；
             名字带毫秒后缀，逐名排除排不掉，必须按固定目录排） -->
        <exclude
            domain="file"
            path="user_picks.key.tmp" />
        <exclude
            domain="file"
            path="ledger_orphan/" />
        <!-- 台账整表的两个原子写中间件（崩溃落在「写完整表 → rename」之间时留下） -->
        <exclude
            domain="file"
            path="user_picks.txt.mig" />
        <exclude
            domain="file"
            path="user_picks.txt.reheader" />
        <!-- 剪贴板图片目录：见 cloud-backup 同名条目的理由（换机迁移后密钥不同，图片一条也解不开） -->
        <exclude
            domain="file"
            path="clipboard/" />
        <exclude
            domain="file"
            path="user_freq.txt.tmp" />
        <exclude
            domain="sharedpref"
            path="jinn_inputmethod.xml" />
        <!-- 平台写的 `.bak`（= 上一版配置，含旧凭据密文）也必须排（2026-10-02 修复 L-408） -->
        <exclude
            domain="sharedpref"
            path="jinn_inputmethod.xml.bak" />
        <exclude
            domain="sharedpref"
            path="jinn_clipboard.xml" />
        <exclude
            domain="sharedpref"
            path="jinn_clipboard.xml.bak" />

    <!-- 索引缓存是可**再生**的（基础 14 MB 上下、可选包各十几 MB）：交给 Auto Backup 只会挤占
         25MB 配额（超限会让整包备份失败，连真正该备份的下载词库也备份不上），而换机恢复后
         它的键（APK mtime）必然对不上，仍要靠清扫自愈。词库包 `dicts/` 是用户下载的**真数据**，
         故意**不**排除（`BUG.md` L-152）。 -->
    <exclude
        domain="file"
        path="index/" />
    <!-- 词库包的下载 / 恢复中间件（断网或崩溃时残留，单个最大 5.89 MB）：
         越过 25MB 配额会让整包备份失败；排除项不支持通配，只能逐名排。
         `dicts/` 本身仍不排除（用户下载的真数据，L-152）。 -->
    <exclude domain="file" path="dicts/part2.xz.tmp" />
    <exclude domain="file" path="dicts/part3.xz.tmp" />
    <exclude domain="file" path="dicts/part4.xz.tmp" />
    <exclude domain="file" path="dicts/custom_user.txt.xz.tmp" />
    <exclude domain="file" path="dicts/custom_user.src.txt.tmp" />
    <exclude domain="file" path="dicts/part2.xz.restore" />
    <exclude domain="file" path="dicts/part3.xz.restore" />
    <exclude domain="file" path="dicts/part4.xz.restore" />
    <exclude domain="file" path="dicts/custom_user.txt.xz.restore" />
    <exclude domain="file" path="dicts/custom_user.src.txt.restore" />
    <!-- 诊断日志目录在 `external` 域（`getExternalFilesDir()/logs/`）里，默认会被上传：
         日志含崩溃快照（退回全量时含其它应用的行）、端点主机名、凭据长度指纹，
         且 32 MB 预算 > 25 MB 配额会让整包备份失败（2026-10-02 修复） -->
    <exclude
        domain="external"
        path="logs/" />
    </device-transfer>
</data-extraction-rules>
