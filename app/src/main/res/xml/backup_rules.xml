<?xml version="1.0" encoding="utf-8"?>
<!--
  剪贴板历史备份规则（方案第二十一节）：
  剪贴板数据库含加密正文，密钥由 Keystore 托管（Keystore 本身不可备份），
  因此数据库被恢复也无密钥可解；但仍按最小权限原则排除，防止任何泄露面。
-->
<full-backup-content>
    <!-- 排除剪贴板历史数据库（含加密正文） -->
    <exclude
        domain="database"
        path="jinn_clipboard.db" />
    <exclude
        domain="database"
        path="jinn_clipboard.db-journal" />
    <exclude
        domain="database"
        path="jinn_clipboard.db-wal" />
    <exclude
        domain="database"
        path="jinn_clipboard.db-shm" />
    <!-- 用户词频：明文记录用户选过的词（含姓名、地址、账号等），必须排除。
         它比剪贴板库更"可读"（后者有 Keystore 加密兜底），不能漏。 -->
    <exclude
        domain="file"
        path="user_freq.txt" />
    <exclude
        domain="file"
        path="user_freq.txt.tmp" />
    <!-- 选择台账（入 user_picks.txt）：26 键选过的词 + 读音，属长期留痕的隐私数据；
         默认关闭，但仍必须排除备份/迁移，避免「用户没开也被云备份带走」。
         2026-10-21 起台账逐行加密，密钥包裹件 user_picks.key 同理排除 —— 它由 Keystore 保护、
         换机后必然解不开，带过去只会把「解不开的台账」留在新机器上 -->
    <exclude
        domain="file"
        path="user_picks.txt" />
    <exclude
        domain="file"
        path="user_picks.key" />
    <!-- 密钥件残留（原子写的中间件：先写 .tmp 再改名，进程被杀时会留下） -->
    <exclude
        domain="file"
        path="user_picks.key.tmp" />
    <!-- 台账整表的两个原子写中间件：崩溃落在「写完整表 → rename」之间时会留下。
         排除项不支持通配，必须逐名写；deleteFile 只删主文件，残留会跟着备份出机 -->
    <exclude
        domain="file"
        path="user_picks.txt.mig" />
    <exclude
        domain="file"
        path="user_picks.txt.reheader" />
    <!-- 孤儿件目录：密钥件丢失时台账 / 词频被改名到这里（名字带毫秒后缀，逐名排除排不掉） -->
    <exclude
        domain="file"
        path="ledger_orphan/" />
    <!-- 剪贴板图片目录（filesDir/clipboard/）：原图与缩略图都是密文，密钥（Keystore）本就不可备份，
         恢复后一条也解不开；而它是本模块最重的数据（几十 MB 级），进了备份只会挤爆 25MB 配额、
         连真正该备份的 dicts/ 都备不上（与 index/ 同款代价）。
         三处规则必须同时排：本文件（full-backup）+ data_extraction_rules.xml 的 cloud-backup 与
         device-transfer（2026-10-10 实施计划 §4.1 第 11 项）。 -->
    <exclude
        domain="file"
        path="clipboard/" />
    <!-- 配置：含自建服务端地址/端口、提示词（用户自己写的正文）、双拼方案等，
         与剪贴板库、词频一样不该随备份出炉。 -->
    <exclude
        domain="sharedpref"
        path="jinn_inputmethod.xml" />
    <!-- 平台在 apply/commit 时会留一份同目录的 `.bak`（内容 = **上一版**配置，含旧凭据密文）：
         只排主名等于把它留在备份范围里（2026-10-02 修复 L-408） -->
    <exclude
        domain="sharedpref"
        path="jinn_inputmethod.xml.bak" />
    <exclude
        domain="sharedpref"
        path="jinn_clipboard.xml" />
    <exclude
        domain="sharedpref"
        path="jinn_clipboard.xml.bak" />
    <!-- 索引缓存是可**再生**的（基础 14 MB 上下、可选包各十几 MB）：交给 Auto Backup 只会挤占
         25MB 配额（超限会让整包备份失败，连真正该备份的下载词库也备份不上），而换机恢复后
         它的键（APK mtime）必然对不上，仍要靠清扫自愈。词库包 `dicts/` 是用户下载的**真数据**，
         故意**不**排除（`BUG.md` L-152）。 -->
    <exclude
        domain="file"
        path="index/" />
    <!-- 词库包的下载 / 恢复中间件（断网或崩溃时残留，单个最大 5.89 MB）：
         越过 25MB 配额会让整包备份失败；排除项不支持通配，只能逐名排。
         `dicts/` 本身仍不排除（用户下载的真数据，L-152）。 -->
    <exclude domain="file" path="dicts/part2.xz.tmp" />
    <exclude domain="file" path="dicts/part3.xz.tmp" />
    <exclude domain="file" path="dicts/part4.xz.tmp" />
    <exclude domain="file" path="dicts/custom_user.txt.xz.tmp" />
    <exclude domain="file" path="dicts/custom_user.src.txt.tmp" />
    <exclude domain="file" path="dicts/part2.xz.restore" />
    <exclude domain="file" path="dicts/part3.xz.restore" />
    <exclude domain="file" path="dicts/part4.xz.restore" />
    <exclude domain="file" path="dicts/custom_user.txt.xz.restore" />
    <exclude domain="file" path="dicts/custom_user.src.txt.restore" />
    <!-- 诊断日志目录（`getExternalFilesDir()/logs/`）落在 Auto Backup 的 **`external` 域**里，
         默认会被整包上传 —— 而手工导出诊断包是需要用户主动点按钮的（2026-10-02 修复）：
         · 隐私：日志里有崩溃快照，退回全量抓取时**含其它应用的 I/D/W/E 行**（L-193）、
           端点主机名（L-212）、凭据长度指纹（L-384）；
         · 配额：目录预算 32 MB > Auto Backup 的 25 MB 配额，超限会让**整包备份失败**，
           连用户下载的 `dicts/` 都备不上（与 `index/` 同款代价，见 L-152）。
         云备份与换机迁移三条规则（full-backup-content / cloud-backup / device-transfer）必须同时排。 -->
    <exclude
        domain="external"
        path="logs/" />
    </full-backup-content>
