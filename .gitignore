# Gradle 构建产物
.gradle/
build/
*/build/

# 本机 SDK 路径（每人路径不同，不入库）
local.properties

# IDE
.idea/
*.iml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# 代码图谱索引（AI 工具生成，可随时重建）
.codegraph/

# AI 工具会话状态
.omo/

# 签名密钥与敏感配置
*.keystore
*.jks

# 真机 QA 临时产物（截图/UI dump/调试脚本）
artifacts/

# 词库构建中间产物（由 tools/dict_builder 重新生成）
tools/dict_builder/out/

# APK 产物（安装包不入库）
*.apk

# 签名密码（本地密钥，不入库）
keystore.properties

# 第三方源码（服务端，非本仓库）
/CapsWriter-Offline-master/

# 云服务凭证 / 会话密钥（含真实凭据，绝不能入库）
ses_*.json
*service-account*.json
*-credentials.json

# AI 工具工作区状态（不入库）
.workbuddy/

# 参考字表原始压缩包（内容已提取为 assets/common_chars.txt）
docs/*.zip

# 词库源文件（28MB 未压缩，可由 assets 基础包 + release 扩展包还原，不入库）
tools/dict_builder/source/

# 项目文档（本地资料，按约定不推送）
docs/

# 词库包构建产物（已作为 Release 附件分发，不入库）
release/

# Python 缓存
__pycache__/
*.pyc

# 交接/临时文档（本地保留）
HANDOFF.md

# 接手指南（一次性入手文档，已归档 docs/）
ONBOARDING.md

# 第三方词库源码（调研用，非本项目代码）
tools/dict_builder/THUOCL-master/
# 注音中间产物（可由脚本重新生成）
tools/dict_builder/THUOCL注音输出/

# 提交信息临时文件
.cm.txt
.commitmsg.txt
