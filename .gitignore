# Gradle 构建产物
.gradle/
build/
*/build/

# 本机 SDK 路径（每人路径不同，不入库）
local.properties

# IDE
.idea/
*.iml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# 代码图谱索引（AI 工具生成，可随时重建）
.codegraph/

# AI 工具会话状态
.omo/

# 签名密钥与敏感配置
*.keystore
*.jks

# 真机 QA 临时产物（截图/UI dump/调试脚本）
artifacts/

# 词库构建中间产物（由 tools/dict_builder 重新生成）
tools/dict_builder/out/

# APK 产物（安装包不入库）
*.apk
